# generated by platform-skills
#
# setup-agents tooling metadata — NOT a Codex-discovered config file.
# Codex discovers only AGENTS.md / AGENTS.override.md (Git-root walk down to the
# working directory). It has no repo-level agent roster and no activation prefix.
#
# This file exists so setup-agents itself has a machine-readable record of the
# roster and the per-agent model choices: scripts/verify-agents.sh asserts it is
# present when the manifest carries the `codex` token, and upgrade mode reads it
# to re-surface model selections. Roster completeness is checked against the
# `## Agent roster` table in AGENTS.md, not against this file — nothing parses
# the entries below.
# Deleting it fails that presence check and loses the model-selection recall.
# Codex behaviour is unaffected either way.
interface:
  display_name: "__DISPLAY_NAME__"
  short_description: "__SHORT_DESCRIPTION__"
  default_prompt: "__DEFAULT_PROMPT__"

policy:
  allow_implicit_invocation: true

agents:
__AGENT_ENTRIES__
